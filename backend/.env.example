FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
# Chemin relatif à l'instance_path de Flask (backend/instance/) : ceci pointe vers backend/instance/app.db
DATABASE_URL=sqlite:///app.db
# Pour utiliser MySQL à la place (voir README, section "Base de données MySQL") :
# DATABASE_URL=mysql+pymysql://user:motdepasse@127.0.0.1:3306/agence_location
UPLOAD_FOLDER=app/static_uploads
CURRENCY_LABEL=MAD
# Serveur central de licences + coordonnées affichées à l'utilisateur si l'essai
# est terminé / le compte suspendu (le verrou n'est actif qu'en build packagé).
# LICENCE_SERVER_URL=https://51-170-142-59.sslip.io
# CONTACT_EMAIL=elmailoudiali@gmail.com

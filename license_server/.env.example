FLASK_APP=wsgi.py
FLASK_ENV=development
# Base dédiée aux licences (séparée de la base métier de l'app agence_location) :
DATABASE_URL=mysql+pymysql://user:motdepasse@127.0.0.1:3306/licences_db
# Secret partagé pour la console admin (header X-Admin-Token). Générer une vraie
# valeur aléatoire longue avant tout déploiement réel.
ADMIN_TOKEN=change-me-to-a-long-random-secret

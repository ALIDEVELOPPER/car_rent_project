FLASK_APP=wsgi.py
FLASK_ENV=production
# Base des installations (séparée de la base métier des agences). SQLite suffit ;
# pour MySQL : mysql+pymysql://user:motdepasse@127.0.0.1:3306/licences_db
DATABASE_URL=sqlite:////opt/licence-server/data/licences.db
# Secret de la console admin (header X-Admin-Token). Générer : openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-secret
